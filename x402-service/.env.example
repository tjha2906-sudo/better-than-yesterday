# =========================================================
# x402-service production environment variables.
# Copy to the hosting platform's environment config (never
# commit the real .env). Port is usually injected by the
# host (e.g. Render/Railway set PORT automatically).
# =========================================================

PORT=4021

# Django REST API this service talks to.
DJANGO_API_URL=https://API-PRODUCTION-URL

# GoPlausible x402 facilitator.
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Algorand Testnet address that receives payments.
RESOURCE_PAY_TO=AN-ALGORAND-TESTNET-ADDRESS

# Algorand account mnemonic used to sign the payment transaction.
AVM_MNEMONIC=YOUR-25-WORD-MNEMONIC